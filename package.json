{
  "name": "crypto-alert",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "backend",
    "frontend",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"npm run start:dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "npm run test -w e2e --",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run test:e2e",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "secrets:check": "node scripts/check-secrets.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "simple-git-hooks": "^2.11.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "simple-git-hooks@2.14.0": true
  }
}
