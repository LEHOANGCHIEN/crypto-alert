# Copy to .env (never commit .env). See docs/ARCHITECTURE.md §10.1
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/crypto_alert
# Required: 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
MARKET_DATA_PROVIDER=binance
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision
MOCK_AUTO_TICK=false
ENABLE_TEST_ENDPOINTS=false
LOGIN_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY_HOPS=0
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=../frontend/dist
LOG_LEVEL=info
# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
